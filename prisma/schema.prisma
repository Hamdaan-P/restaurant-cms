generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  DRAFT
  PUBLISHED
}

model MenuItem {
  id            String  @id @default(cuid())
  name          String
  description   String
  price         Int
  image         String
  order         Int
  featured      Boolean @default(false)
  status        Status  @default(DRAFT)
  publishedData Json?
}

model GalleryImage {
  id            String @id @default(cuid())
  image         String
  caption       String
  order         Int
  status        Status @default(DRAFT)
  publishedData Json?
}

model StaffMember {
  id            String @id @default(cuid())
  name          String
  designation   String
  photo         String
  order         Int
  status        Status @default(PUBLISHED)
  publishedData Json?
}

model Home {
  id            String @id @default("singleton")
  headline      String
  subtext       String
  buttonText    String
  status        Status @default(DRAFT)
  publishedData Json?
}

model About {
  id            String @id @default("singleton")
  story         String
  photo         String
  status        Status @default(DRAFT)
  publishedData Json?
}

model Contact {
  id            String @id @default("singleton")
  address       String
  phone         String
  email         String
  hours         String
  status        Status @default(DRAFT)
  publishedData Json?
}

model SiteSettings {
  id             String @id @default("singleton")
  restaurantName String
  tagline        String
  status         Status @default(PUBLISHED)
  publishedData  Json?
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}