# Copy this file to .env.local and fill in real values. Never commit actual secrets.

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Used by prisma/create-admin.ts to create or update the admin login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Used by Auth.js to sign/encrypt session tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=changeme
